{
  "name": "xnet",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm desktop:dev",
    "dev:ui": "vite --host 127.0.0.1 --port 4381",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "typecheck": "pnpm check",
    "lint": "prettier --check apps/desktop/ui scripts/*.mjs deploy/hub/*.mjs .github/workflows/*.yml && cargo fmt --all -- --check && node scripts/check-repository.mjs",
    "test": "pnpm test:js && cargo test --workspace --locked",
    "test:js": "node --test scripts/*.test.mjs deploy/hub/*.test.mjs",
    "test:extension": "node --test scripts/extension-protocol.test.mjs",
    "desktop:dev": "cd apps/desktop && tauri dev",
    "desktop:build": "pnpm build && cd apps/desktop && tauri build",
    "registry": "cargo run --locked -p community-registry --",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "prettier": "^3.6.2",
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.16"
  }
}
