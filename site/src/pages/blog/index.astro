---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/sections/Nav.astro'
import Footer from '../../components/sections/Footer.astro'
import BlogArt from '../../components/blog/BlogArt.astro'
import Byline from '../../components/blog/Byline.astro'
import { publishedPosts, formatPostDate } from '../../data/blog'
const posts = publishedPosts()
const tags = [
  'all',
  'philosophy',
  'privacy',
  'decentralization',
  'protocol',
  'nature',
  'economics',
  'personal'
]
---

<Base
  title="Blog — xNet"
  description="Essays on owning your data, local-first software, and the open web."
>
  <Nav />
  <main id="main-content">
    <header class="m-page-hero">
      <div class="m-wrap">
        <div class="flex items-center justify-between gap-4">
          <h1 class="m-title">Blog</h1>
          <a class="m-button secondary" href="/blog/rss.xml">
            RSS ↗
          </a>
        </div>
        <p class="m-lede">
          Field notes on owning your data, building open tools, and the kind of internet we want to
          use.
        </p>
      </div>
    </header>
    <section class="m-section">
      <div class="m-wrap">
        <div class="journal-controls">
          <h2 class="text-lg font-semibold">All {posts.length} essays</h2>
          <label class="m-note">
            Find an essay
            <input id="essay-search" type="search" placeholder="Search titles and descriptions" />
          </label>
        </div>
        <div class="journal-filters" aria-label="Filter essays by topic">
          {tags.map((tag) => (
            <button data-topic={tag} aria-pressed={tag === 'all'}>
              {tag === 'all' ? 'All subjects' : tag}
            </button>
          ))}
        </div>
        <div class="journal-grid">
          {posts.map((post, i) => (
            <article
              class="journal-entry"
              data-essay
              data-search={`${post.title} ${post.description}`.toLowerCase()}
              data-tags={post.tags.join(' ')}
            >
              <a class="journal-art" href={`/blog/${post.slug}`}>
                <BlogArt
                  slug={post.slug}
                  class="h-full w-full object-cover"
                  sizes="(max-width: 500px) 80px, 120px"
                />
              </a>
              <div class="min-w-0">
                <p class="text-xs text-gray-500">
                  {i === 0 && (
                    <span class="mr-2 font-semibold text-indigo-600 dark:text-indigo-400">
                      Latest
                    </span>
                  )}
                  <time datetime={post.pubDate}>{formatPostDate(post.pubDate)}</time> ·{' '}
                  {post.readingMinutes} min
                </p>
                <h3 class="mt-2 text-lg font-semibold leading-snug">
                  <a
                    class="hover:text-indigo-600 dark:hover:text-indigo-400"
                    href={`/blog/${post.slug}`}
                  >
                    {post.title}
                  </a>
                </h3>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                  {post.description}
                </p>
                <div class="mt-3 text-xs">
                  <Byline post={post} compact />
                </div>
              </div>
            </article>
          ))}
        </div>
        <p id="essay-empty" class="m-copy mt-8" role="status" hidden>
          No essays match that search. Try another word or subject.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#essay-search')
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-topic]')]
  const essays = [...document.querySelectorAll<HTMLElement>('[data-essay]')]
  let topic = 'all'
  const filter = () => {
    const query = input?.value.trim().toLowerCase() ?? ''
    essays.forEach((essay) => {
      essay.hidden = !(
        essay.dataset.search?.includes(query) &&
        (topic === 'all' || essay.dataset.tags?.split(' ').includes(topic))
      )
    })
    const empty = document.getElementById('essay-empty')
    if (empty) empty.hidden = essays.some((essay) => !essay.hidden)
  }
  input?.addEventListener('input', filter)
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      topic = button.dataset.topic ?? 'all'
      filters.forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
      filter()
    })
  )
</script>
<style>
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .journal-entry {
    display: flex;
    gap: 18px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 18px;
  }
  .journal-art {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 8px;
  }
  .journal-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .journal-controls label {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .journal-controls input {
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 9px 12px;
    border-radius: 6px;
    color: var(--ink);
    font-size: 13px;
    width: 260px;
  }
  .journal-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 24px;
  }
  .journal-filters button {
    font-size: 12px;
    border: 1px solid var(--rule);
    padding: 5px 10px;
    border-radius: 6px;
    text-transform: capitalize;
  }
  .journal-filters [aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  [data-essay][hidden] {
    display: none;
  }
  @media (max-width: 1000px) {
    .journal-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .journal-controls {
      align-items: start;
      flex-direction: column;
    }
    .journal-controls label {
      display: grid;
      gap: 6px;
      width: 100%;
    }
    .journal-controls input {
      width: 100%;
    }
    .journal-entry {
      padding: 14px;
      gap: 12px;
    }
    .journal-art {
      width: 80px;
      height: 80px;
    }
  }
</style>
