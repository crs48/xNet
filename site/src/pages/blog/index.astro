---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/sections/Nav.astro'
import Footer from '../../components/sections/Footer.astro'
import BlogArt from '../../components/blog/BlogArt.astro'
import Byline from '../../components/blog/Byline.astro'
import { publishedPosts, formatPostDate } from '../../data/blog'
const posts = publishedPosts()
const [featured] = posts
const tags = [
  'all',
  'philosophy',
  'privacy',
  'decentralization',
  'protocol',
  'nature',
  'economics',
  'personal'
]
---

<Base
  title="Field notes — xNet"
  description="Essays about the kind of internet we want to inhabit: ownership, open tools, living networks, and the people beneath the data."
>
  <Nav />
  <main id="main-content">
    <header class="m-page-hero">
      <div class="m-wrap">
        <p class="m-eyebrow">The xNet journal</p>
        <h1 class="m-title">
          Field notes from
          <br />
          <em>the open web.</em>
        </h1>
        <div class="m-section-top mb-0">
          <p class="m-lede">
            Pirate ships, forest floors, open workshops, and the things software can learn from
            them. These are the ideas we’re building with.
          </p>
          <a class="m-text-link shrink-0" href="/blog/rss.xml">
            Follow via RSS ↗
          </a>
        </div>
      </div>
    </header>
    <section class="m-section">
      <div class="m-wrap">
        {featured && (
          <article class="featured-essay">
            <a href={`/blog/${featured.slug}`}>
              <BlogArt
                slug={featured.slug}
                class="m-essay-image"
                sizes="(max-width: 800px) 100vw, 55vw"
                eager
              />
            </a>
            <div>
              <p class="m-eyebrow">Latest essay · {featured.readingMinutes} min read</p>
              <h2 class="m-heading mt-5">
                <a href={`/blog/${featured.slug}`}>{featured.title}</a>
              </h2>
              <p class="m-copy mt-6">{featured.description}</p>
              <div class="mt-6">
                <Byline post={featured} />
              </div>
              <a class="m-text-link mt-6" href={`/blog/${featured.slug}`}>
                Read the essay →
              </a>
            </div>
          </article>
        )}
      </div>
    </section>
    <section class="m-section">
      <div class="m-wrap">
        <div class="journal-controls">
          <h2 class="m-eyebrow">The collection · {posts.length} essays</h2>
          <label class="m-note">
            Find an essay
            <input id="essay-search" type="search" placeholder="Search the field notes" />
          </label>
        </div>
        <div class="journal-filters" aria-label="Filter essays by topic">
          {tags.map((tag) => (
            <button data-topic={tag} aria-pressed={tag === 'all'}>
              {tag === 'all' ? 'All subjects' : tag}
            </button>
          ))}
        </div>
        <div class="journal-grid">
          {posts.map((post) => (
            <article
              class="m-essay"
              data-essay
              data-search={`${post.title} ${post.description}`.toLowerCase()}
              data-tags={post.tags.join(' ')}
            >
              <a href={`/blog/${post.slug}`}>
                <BlogArt
                  slug={post.slug}
                  class="m-essay-image"
                  sizes="(max-width: 800px) 100vw, 33vw"
                />
                <p class="m-note mt-4">
                  {formatPostDate(post.pubDate)} · {post.readingMinutes} min read
                </p>
                <h3>{post.title}</h3>
                <p>{post.tags.filter((t) => t !== 'essay').join(' / ')}</p>
              </a>
            </article>
          ))}
        </div>
        <p id="essay-empty" class="m-copy mt-8" role="status" hidden>
          No essays match that search. Try another word or subject.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#essay-search')
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-topic]')]
  const essays = [...document.querySelectorAll<HTMLElement>('[data-essay]')]
  let topic = 'all'
  const filter = () => {
    const query = input?.value.trim().toLowerCase() ?? ''
    essays.forEach((essay) => {
      essay.hidden = !(
        essay.dataset.search?.includes(query) &&
        (topic === 'all' || essay.dataset.tags?.split(' ').includes(topic))
      )
    })
    const empty = document.getElementById('essay-empty')
    if (empty) empty.hidden = essays.some((essay) => !essay.hidden)
  }
  input?.addEventListener('input', filter)
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      topic = button.dataset.topic ?? 'all'
      filters.forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
      filter()
    })
  )
</script>
<style>
  .featured-essay {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .featured-essay .m-essay-image {
    aspect-ratio: 1.15;
  }
  .featured-essay .m-copy {
    font-size: 16px;
  }
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 28px;
  }
  .journal-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .journal-controls label {
    display: grid;
    gap: 8px;
  }
  .journal-controls input {
    background: transparent;
    border: 1px solid var(--rule);
    padding: 11px 14px;
    border-radius: 7px;
    color: var(--ink);
    font-size: 14px;
    width: 280px;
  }
  .journal-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 30px 0 40px;
  }
  .journal-filters button {
    font-size: 12px;
    border: 1px solid var(--rule);
    padding: 7px 12px;
    border-radius: 99px;
    text-transform: capitalize;
  }
  .journal-filters [aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  [data-essay][hidden] {
    display: none;
  }
  @media (max-width: 800px) {
    .featured-essay {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .featured-essay .m-essay-image {
      aspect-ratio: 2;
    }
    .journal-grid {
      grid-template-columns: 1fr 1fr;
    }
    .journal-controls {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (max-width: 500px) {
    .journal-grid {
      grid-template-columns: 1fr;
    }
    .journal-controls input {
      width: 100%;
    }
  }
</style>
