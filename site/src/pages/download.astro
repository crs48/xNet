---
import Base from '../layouts/Base.astro'
import Nav from '../components/sections/Nav.astro'
import Footer from '../components/sections/Footer.astro'

const platforms = [
  {
    id: 'macos', title: 'macOS', icon: 'apple', description: 'Apple silicon and Intel Macs.',
    downloads: [
      { platform: 'macos-arm64', format: 'dmg', label: 'Apple silicon', detail: 'M1 and later · macOS 11+', primary: true },
      { platform: 'macos-x64', format: 'dmg', label: 'Intel', detail: 'Intel processor · macOS 10.15+', primary: false },
    ],
    help: 'Not sure? Check About This Mac.',
  },
  {
    id: 'windows', title: 'Windows', icon: 'windows', description: 'Windows 10 and 11 · 64-bit.',
    downloads: [
      { platform: 'windows-x64', format: 'exe', label: 'Windows', detail: 'Intel & AMD processors', primary: true },
    ],
    note: 'A familiar installer. Open the download and follow the setup steps.',
    help: 'Windows ARM isn’t supported yet.',
  },
  {
    id: 'linux', title: 'Linux', icon: 'linux', description: 'Your desktop. Your distribution.',
    downloads: [
      { platform: 'linux-x64', format: 'deb', label: '.deb', detail: 'Ubuntu 24.04 or compatible · x64', primary: true },
      { platform: 'linux-x64', format: 'AppImage', label: 'AppImage', detail: 'glibc 2.39+ · FUSE 2 · x64', primary: false },
    ],
    help: 'Choose the package for your setup.',
  },
]
---
<Base title="Download xNet — desktop beta" description="Download xNet for Apple silicon and Intel Macs, Windows, and Linux. An open-source community app with signed updates.">
  <Nav />
  <main id="main-content" class="m-wrap download-page">
    <header class="download-hero">
      <p class="eyebrow">A network of our own</p>
      <h1>Make yourself at home.</h1>
      <p class="m-lede">Get xNet for your desktop. A place for conversations, music, and video, shared by your people.</p>
      <div class="release-status"><span class="status-dot" aria-hidden="true"></span><p id="release-status" role="status">Checking for the latest beta…</p></div>
    </header>

    <section class="platform-grid" aria-label="Choose your operating system">
      {platforms.map(({ id, title, icon, description, downloads, note, help }) => (
        <article class="platform-card" data-system={id} aria-labelledby={'platform-' + id}>
          <span class="device-badge" hidden>Your platform</span>
          <div class="platform-mark"><img src={'/platforms/' + icon + '.svg'} width="36" height="40" alt="" class="platform-logo" /></div>
          <h2 id={'platform-' + id}>{title}</h2>
          <p class="platform-description">{description}</p>
          <div class="download-options">
            {downloads.map(({ platform, format, label, detail, primary }) => (
              <div class="download-option">
                <a class:list={['download-link', { primary }]} data-platform={platform} data-format={format} aria-label={'Download xNet for ' + (id === 'macos' ? label + ' Mac' : title) + ' (.' + format + ')'} hidden>
                  <span>{label === '.deb' || label === 'AppImage' ? 'Download ' + label : 'Download for ' + label}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v4h14v-4" /></svg>
                </a>
                <p class="download-pending">Preparing download…</p>
                <p class="option-detail">{detail}<span class="download-size"></span></p>
              </div>
            ))}
            {note && <p class="platform-note">{note}</p>}
          </div>
          <div class="platform-footer"><p>{help}</p><a href={'#install-' + id}>Installation help <span aria-hidden="true">↗</span></a></div>
        </article>
      ))}
    </section>

    <div class="release-meta">
      <p>Free to use. Open source. Yours to explore.</p>
      <div class="release-links"><a id="release-notes" href="https://github.com/crs48/xNet/releases?q=community-v">All beta releases <span aria-hidden="true">↗</span></a><a id="checksums" hidden>Checksums <span aria-hidden="true">↗</span></a></div>
    </div>
    <noscript><p class="no-script">Download the appropriate installer from <a href="https://github.com/crs48/xNet/releases?q=community-v">GitHub’s beta releases</a>. JavaScript is only needed to show the latest download links here.</p></noscript>

    <aside class="beta-notice" aria-labelledby="beta-heading">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10v2" /></svg>
      <div><h2 id="beta-heading">A heads-up about this beta</h2><p>Mac and Windows may warn you about an unverified developer. These builds are self-signed, not Apple-notarized or signed by a verified Windows publisher. Downloads and updates have xNet signatures.</p><p class="availability-note">Desktop only for now. iOS, Android, and Windows/Linux ARM aren’t available yet.</p></div>
    </aside>

    <section class="installation-section" aria-labelledby="installation">
      <div class="installation-intro"><p class="eyebrow">A few small steps</p><h2 id="installation">Settle in.</h2><p>Install xNet, choose a name, and invite someone you’d like to share it with.</p><div class="update-note"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.6 7a8 8 0 0 1 13.2-1L20 8M4 16l1.2 2A8 8 0 0 0 18.4 17" /></svg><div><h3>Updates come to you.</h3><p>While the app is open, verified updates download in the background. Choose <strong>Restart to update</strong> when you’re ready.</p></div></div></div>
      <div class="installation-guides">
        <details id="install-macos"><summary><img src="/platforms/apple.svg" width="18" height="20" alt="" class="platform-logo" /><span>Install on macOS</span><span class="disclosure" aria-hidden="true">+</span></summary><div class="guide-content"><p>Open the disk image and drag xNet Community into Applications. Eject the image, then open the app from Applications.</p><p>If macOS blocks it because the developer is unverified, review the warning in <strong>System Settings → Privacy &amp; Security</strong>. Use Open Anyway only if you trust this beta. You don’t need to turn off Gatekeeper.</p><p>To find your processor, open <strong>Apple menu → About This Mac</strong>. Choose Apple silicon for an Apple M-series chip, or Intel for an Intel processor.</p></div></details>
        <details id="install-windows"><summary><img src="/platforms/windows.svg" width="18" height="20" alt="" class="platform-logo" /><span>Install on Windows</span><span class="disclosure" aria-hidden="true">+</span></summary><div class="guide-content"><p>Run the downloaded installer. SmartScreen may say the publisher is unknown; review the source before choosing <strong>More info → Run anyway</strong>. Managed computers may block unverified installers.</p><p>The installer will offer WebView2 if it isn’t already installed.</p></div></details>
        <details id="install-linux"><summary><img src="/platforms/linux.svg" width="18" height="20" alt="" class="platform-logo" /><span>Install on Linux</span><span class="disclosure" aria-hidden="true">+</span></summary><div class="guide-content"><p>Ubuntu 24.04 is the tested baseline. For the Debian package, use your package manager so it resolves GTK and WebKit dependencies:</p><pre><code id="linux-install">sudo apt install ./xnet-community-VERSION-linux-x64.deb</code></pre><p>For AppImage, mark the file executable and open it. AppImage requires FUSE 2 and a compatible distribution; it does not make older Linux libraries compatible.</p><p>Updating a system package may ask for administrator authorization.</p></div></details>
      </div>
    </section>

    <section class="beta-details" aria-labelledby="before-inviting"><h2 id="before-inviting">Before you invite your friends</h2><ul>
      <li>Keep an authorized peer online for history and media. The server doesn’t store private chat history.</li>
      <li>The room owner must be online for new messages. Other members can share history with permission lasting up to five minutes.</li>
      <li>There’s no account recovery or automatic import from the retired Electron app.</li>
      <li>The group protocol doesn’t yet have a forward-secret ratchet. This beta isn’t ready for highly sensitive conversations.</li>
    </ul><a class="guide-link" href="https://github.com/crs48/xNet/blob/main/docs/beta.md">Read the beta guide <span aria-hidden="true">↗</span></a></section>
  </main>
  <Footer />
</Base>

<script>
  const status = document.querySelector<HTMLParagraphElement>('#release-status')!
  // Browsers can report Apple silicon as Intel. Highlight only the OS, never guess the chip.
  const agent = navigator.userAgent
  const mobile = /Android|iPhone|iPad|iPod/.test(agent) || (/Macintosh/.test(agent) && navigator.maxTouchPoints > 1)
  const system = mobile ? null : /Windows NT/.test(agent) ? 'windows' : /Macintosh|Mac OS X/.test(agent) ? 'macos' : /Linux|X11/.test(agent) ? 'linux' : null
  if (system) {
    const card = document.querySelector<HTMLElement>('[data-system="' + system + '"]')
    card?.setAttribute('data-current', 'true')
    const badge = card?.querySelector<HTMLElement>('.device-badge')
    if (badge) badge.hidden = false
  }

  const revealGuide = (id: string) => {
    const guide = document.getElementById(id)
    if (guide instanceof HTMLDetailsElement) guide.open = true
  }
  revealGuide(location.hash.slice(1))
  window.addEventListener('hashchange', () => revealGuide(location.hash.slice(1)))
  document.querySelectorAll<HTMLAnchorElement>('.platform-footer a').forEach((link) => {
    link.addEventListener('click', () => revealGuide(link.hash.slice(1)))
  })

  async function loadDownloads() {
    try {
      const response = await fetch('/releases/community/beta/downloads.json', { cache: 'no-cache' })
      if (!response.ok) throw new Error('Release metadata unavailable')
      const release = await response.json() as { version: string; tag: string; files: { name: string; url: string; size?: number }[] }
      if (!/^\d+\.\d+\.\d+$/.test(release.version) || release.tag !== 'community-v' + release.version || !Array.isArray(release.files)) throw new Error('Invalid release metadata')
      const prefix = 'https://github.com/crs48/xNet/releases/download/' + release.tag + '/'
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.download-link'))
      // Validate the complete download set before showing any links.
      const targets = links.map((link) => {
        const name = 'xnet-community-' + release.version + '-' + link.dataset.platform + '.' + link.dataset.format
        const matches = release.files.filter((entry) => entry.name === name)
        if (matches.length !== 1 || matches[0].url !== prefix + name) throw new Error('Incomplete release')
        return { link, url: prefix + name, size: matches[0].size }
      })
      for (const { link, url, size } of targets) {
        link.href = url
        link.hidden = false
        link.parentElement?.querySelector('.download-pending')?.remove()
        const sizeLabel = link.parentElement?.querySelector('.download-size')
        if (sizeLabel && typeof size === 'number' && Number.isFinite(size) && size > 0) sizeLabel.textContent = (size / 1_000_000).toFixed(1) + ' MB'
      }
      status.textContent = 'Beta ' + release.version + ' · Signed updates'
      const notes = document.querySelector<HTMLAnchorElement>('#release-notes')!
      notes.href = 'https://github.com/crs48/xNet/releases/tag/' + release.tag
      notes.firstChild!.textContent = 'Release notes '
      const sums = document.querySelector<HTMLAnchorElement>('#checksums')!
      sums.href = prefix + 'SHA256SUMS'
      sums.hidden = false
      document.querySelector('#linux-install')!.textContent = 'sudo apt install ./xnet-community-' + release.version + '-linux-x64.deb'
    } catch {
      status.textContent = 'Downloads are temporarily unavailable. Try the beta releases below.'
      document.querySelectorAll('.download-pending').forEach((pending) => { pending.textContent = 'Download currently unavailable' })
    }
  }
  void loadDownloads()
</script>

<style>
  .download-page { max-width: 1080px; padding-block: 72px 80px; }
  .download-hero { text-align: center; margin-bottom: 40px; }
  .eyebrow { font-size: 11px; letter-spacing: .13em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .download-hero h1 { font-size: clamp(36px, 5vw, 58px); line-height: 1.12; font-weight: 600; letter-spacing: -.045em; margin: 16px 0; text-wrap: balance; }
  .download-hero .m-lede { max-width: 510px; margin-inline: auto; font-size: 16px; text-wrap: pretty; }
  .release-status { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--rule); border-radius: 99px; padding: 6px 12px; margin-top: 22px; font-size: 11px; color: var(--muted); background: var(--wash); }
  .status-dot { height: 5px; width: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .platform-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .platform-card { position: relative; display: flex; flex-direction: column; padding: 28px 24px 20px; border: 1px solid var(--rule); border-radius: 20px; background: var(--paper); box-shadow: 0 2px 3px #00000003, 0 10px 28px -18px #00000024; }
  .platform-card[data-current] { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink), 0 12px 32px -20px #00000040; }
  .device-badge { position: absolute; top: 17px; right: 18px; font-size: 10px; font-weight: 500; padding: 4px 9px; border-radius: 99px; background: var(--ink); color: var(--paper); }
  .platform-mark { display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 22px; background: var(--wash); border: 1px solid var(--rule); border-radius: 17px; box-shadow: inset 0 1px 0 #ffffff14; }
  .platform-logo { object-fit: contain; flex-shrink: 0; }
  :global(.dark) .platform-logo { filter: invert(1); }
  .platform-card h2 { font-size: 24px; letter-spacing: -.035em; line-height: 1.2; font-weight: 600; margin-bottom: 8px; }
  .platform-description { font-size: 12px; color: var(--muted); }
  .download-options { display: flex; flex-direction: column; gap: 18px; flex: 1; margin-block: 26px 22px; }
  .download-link { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 46px; padding: 12px 14px; font-size: 12px; font-weight: 500; border-radius: 10px; border: 1px solid var(--rule); background: var(--paper); box-shadow: 0 1px 2px #00000008; transition: transform .15s ease, box-shadow .15s ease; }
  .download-link.primary { color: var(--paper); background: var(--ink); border-color: var(--ink); }
  .download-link:hover { transform: translateY(-1px); box-shadow: 0 4px 10px #00000015; }
  .download-link svg { flex-shrink: 0; opacity: .8; }
  .option-detail { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 8px; font-size: 10px; color: var(--muted); margin: 7px 2px 0; line-height: 1.6; }
  .download-size { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .platform-note { color: var(--muted); font-size: 12px; line-height: 1.8; max-width: 230px; padding: 5px 2px; }
  .platform-footer { border-top: 1px solid var(--rule); padding-top: 16px; font-size: 10px; color: var(--muted); }
  .platform-footer a { display: inline-flex; gap: 6px; color: var(--ink); margin-top: 6px; font-size: 11px; }
  .platform-footer a:hover, .release-links a:hover, .guide-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .download-pending { min-height: 46px; display: flex; align-items: center; padding: 12px 14px; border-radius: 10px; background: var(--wash); color: var(--muted); font-size: 11px; }
  [hidden] { display: none !important; }
  .release-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 20px; margin-top: 20px; font-size: 11px; color: var(--muted); }
  .release-links { display: flex; gap: 20px; color: var(--ink); }
  .beta-notice { display: flex; align-items: flex-start; gap: 16px; margin-top: 40px; padding: 22px 24px; background: var(--wash); border: 1px solid var(--rule); border-radius: 14px; }
  .beta-notice > svg { flex-shrink: 0; margin-top: 1px; color: var(--muted); }
  .beta-notice h2 { font-size: 13px; font-weight: 600; margin-bottom: 5px; }
  .beta-notice p { color: var(--muted); font-size: 12px; line-height: 1.8; max-width: 850px; }
  .beta-notice .availability-note { font-size: 11px; margin-top: 6px; }
  .installation-section { display: grid; grid-template-columns: 1fr 1.35fr; gap: 64px; margin-top: 72px; }
  .installation-intro h2 { font-size: 32px; line-height: 1.2; font-weight: 500; letter-spacing: -.035em; margin: 12px 0; }
  .installation-intro > p:not(.eyebrow) { font-size: 13px; line-height: 1.8; color: var(--muted); max-width: 310px; }
  .update-note { display: flex; gap: 12px; align-items: flex-start; margin-top: 28px; }
  .update-note svg { flex-shrink: 0; margin-top: 2px; }
  .update-note h3 { font-size: 12px; font-weight: 600; margin-bottom: 5px; }
  .update-note p { font-size: 12px; line-height: 1.8; color: var(--muted); }
  .installation-guides details { border-bottom: 1px solid var(--rule); scroll-margin-top: 92px; }
  .installation-guides details:first-child { border-top: 1px solid var(--rule); }
  summary { display: flex; align-items: center; gap: 14px; cursor: pointer; padding: 22px 2px; list-style: none; font-size: 13px; font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  .disclosure { font-size: 20px; line-height: 1; font-weight: 300; margin-left: auto; color: var(--muted); transition: transform .15s; }
  details[open] .disclosure { transform: rotate(45deg); }
  .guide-content { padding: 0 0 24px 34px; font-size: 12px; line-height: 1.9; color: var(--muted); }
  .guide-content p + p { margin-top: 12px; }
  pre { margin-block: 14px; padding: 14px; background: var(--wash); border: 1px solid var(--rule); border-radius: 8px; overflow: auto; font-size: 11px; }
  .beta-details { border-top: 1px solid var(--rule); margin-top: 56px; padding-top: 28px; }
  .beta-details h2 { font-size: 14px; font-weight: 500; margin-bottom: 16px; }
  .beta-details ul { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 40px; list-style: disc; padding-left: 16px; font-size: 12px; color: var(--muted); line-height: 1.8; }
  .guide-link { display: inline-block; font-size: 11px; margin-top: 18px; }
  .no-script { padding: 16px; margin-top: 16px; background: var(--wash); font-size: 13px; }
  .no-script a { text-decoration: underline; }
  @media (max-width: 900px) { .platform-card { padding: 24px 18px 18px; } .platform-grid { gap: 12px; } .download-link { padding-inline: 10px; font-size: 11px; } .installation-section { gap: 32px; } }
  @media (max-width: 720px) { .download-page { max-width: 480px; padding-top: 40px; } .download-hero { margin-bottom: 28px; } .download-hero .m-lede { font-size: 14px; } .platform-grid { grid-template-columns: 1fr; gap: 18px; } .platform-card { padding: 26px; } .download-link { font-size: 13px; padding-inline: 14px; } .platform-note { max-width: none; } .platform-description, .option-detail, .platform-footer { font-size: 12px; } .platform-footer a { font-size: 12px; } .release-meta { justify-content: center; text-align: center; gap: 12px; } .beta-notice { padding: 20px; gap: 12px; } .installation-section { grid-template-columns: 1fr; gap: 28px; margin-top: 48px; } .installation-intro > p:not(.eyebrow) { max-width: none; } .beta-details ul { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .download-link, .disclosure { transition: none; } .download-link:hover { transform: none; } }
</style>
