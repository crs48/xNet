---
import Base from '../layouts/Base.astro'
import Nav from '../components/sections/Nav.astro'
import Footer from '../components/sections/Footer.astro'

// GitHub repo for release lookups (build-time fetch)
const REPO = 'crs48/xNet'
const releasesUrl = `https://github.com/${REPO}/releases`
let version: string | null = null
let releaseTag: string | null = null
let assets: { name: string; browser_download_url: string }[] = []

try {
  // The desktop app is published under `v*` tags by electron-release.yml. We must
  // NOT use `releases/latest`: that returns whichever release was published most
  // recently across ALL tags, which is usually an npm package release
  // (e.g. `@xnetjs/trust@x.y.z`) carrying no desktop assets. Fetch the list and
  // pick the newest non-draft release whose tag looks like `v<number>`.
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases?per_page=100`, {
    headers: { Accept: 'application/vnd.github.v3+json' }
  })
  if (res.ok) {
    const releases = await res.json()
    const desktop = Array.isArray(releases)
      ? releases.find((r) => !r.draft && !r.prerelease && /^v\d/.test(r.tag_name ?? ''))
      : undefined
    if (desktop) {
      releaseTag = desktop.tag_name ?? null
      version = releaseTag?.replace(/^v/, '') ?? null
      assets = desktop.assets ?? []
    }
  }
} catch {
  // The page explicitly shows that the release could not be resolved.
}

// electron-builder names the default-arch (x64) macOS/Linux artifacts without an
// arch suffix and only tags arm64, so the Intel/x64 matchers exclude `arm64`.
function assetUrl(match: (name: string) => boolean): string {
  const asset = assets.find((a) => match(a.name))
  return asset?.browser_download_url ?? releasesUrl
}

// Deep-link to the specific desktop release so "release assets and checksums"
// lands on the build being offered, not the mixed npm/desktop releases index.
const releasePageUrl = releaseTag ? `${releasesUrl}/tag/${releaseTag}` : releasesUrl

const macArm64 = assetUrl((n) => n.endsWith('arm64.dmg'))
const macX64 = assetUrl((n) => n.endsWith('.dmg') && !n.includes('arm64'))
const winSetup = assetUrl((n) => n.endsWith('.exe'))
const linuxAppImage = assetUrl((n) => n.endsWith('.AppImage') && !n.includes('arm64'))
const linuxDeb = assetUrl((n) => n.endsWith('.deb') && !n.includes('arm64'))
---

<Base
  title="Get xNet — A workspace of your own"
  description="Download the xNet desktop alpha for macOS, Windows, or Linux, or explore the browser demo."
>
  <Nav />
  <main id="main-content">
    <header class="m-page-hero">
      <div class="m-wrap">
        <p class="m-eyebrow">Get xNet · Open alpha</p>
        <h1 class="m-title">Download xNet</h1>
        <p class="m-lede">
          Start with a few notes or a small project. The desktop app is the fuller experience; the
          browser demo is a quick way to look around.
        </p>
        <p class="m-note mt-6">
          {version
            ? `Desktop release ${version}`
            : 'Release details could not be loaded. Check GitHub for the current downloads.'}
        </p>
      </div>
    </header>
    <section class="m-section">
      <div class="m-wrap">
        <div class="m-grid-3">
          <article class="download-option" data-platform="mac">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900 shadow-sm">
              <svg
                aria-hidden="true"
                class="h-8 w-8 text-gray-700 dark:text-gray-300"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11" />
              </svg>
            </div>
            <h2>macOS</h2>
            <p>Apple Silicon & Intel</p>
            <a
              class="download-button inline-flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-semibold transition-colors bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
              href={macArm64}
            >
              Apple Silicon ↓
            </a>
            <a
              class="inline-flex border-b border-transparent pb-1 text-sm hover:border-current text-gray-700 dark:text-gray-300"
              href={macX64}
            >
              Intel Mac ↓
            </a>
          </article>
          <article class="download-option" data-platform="windows">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-100 to-blue-200 dark:from-blue-900/50 dark:to-blue-800/50 shadow-sm">
              <svg
                aria-hidden="true"
                class="h-8 w-8 text-blue-600 dark:text-blue-400"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .08V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 .25V22l-10-1.91V13.1l10 .15z" />
              </svg>
            </div>
            <h2>Windows</h2>
            <p>64-bit installer</p>
            <a
              class="download-button inline-flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-semibold transition-colors bg-blue-600 text-white hover:bg-blue-700"
              href={winSetup}
            >
              Download installer ↓
            </a>
            <a
              class="inline-flex border-b border-transparent pb-1 text-sm hover:border-current text-blue-600 dark:text-blue-400"
              href={releasePageUrl}
            >
              Release details ↗
            </a>
          </article>
          <article class="download-option" data-platform="linux">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 to-orange-200 dark:from-orange-900/50 dark:to-orange-800/50 shadow-sm">
              <svg
                aria-hidden="true"
                class="h-8 w-8 text-orange-600 dark:text-orange-400"
                viewBox="0 -1 28 26"
                fill="currentColor"
              >
                <path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a11.966 11.966 0 0 0-2.517 2.453c-1.533 2.023-.156 3.472 1.325 3.472.558 0 1.174-.218 1.76-.574a10.648 10.648 0 0 0 3.71 1.112c.17.018.339.028.507.028 2.012 0 3.426-1.236 4.414-1.236.986 0 2.4 1.236 4.414 1.236.168 0 .337-.01.506-.028a10.648 10.648 0 0 0 3.71-1.112c.587.356 1.203.574 1.76.574 1.482 0 2.859-1.449 1.326-3.472a11.966 11.966 0 0 0-2.517-2.453c.123-.805-.009-1.657-.287-2.489-.589-1.771-1.831-3.47-2.716-4.521-.75-1.067-.974-1.928-1.05-3.02-.065-1.491 1.056-5.965-3.17-6.298A5.11 5.11 0 0 0 12.504 0z" />
              </svg>
            </div>
            <h2>Linux</h2>
            <p>x64 · More assets on GitHub</p>
            <a
              class="download-button inline-flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-semibold transition-colors bg-orange-700 text-white hover:bg-orange-800"
              href={linuxAppImage}
            >
              Download AppImage ↓
            </a>
            <a
              class="inline-flex border-b border-transparent pb-1 text-sm hover:border-current text-orange-700 dark:text-orange-400"
              href={linuxDeb}
            >
              Debian / Ubuntu ↓
            </a>
          </article>
        </div>
        <div class="m-banner mt-12">
          <p>
            <strong>This is alpha software.</strong> Features and formats can change. Start with
            work you have backed up, and keep your own workspace exports.{' '}
            <a class="underline" href={releasePageUrl}>
              Read the release notes and check the available assets.
            </a>
          </p>
        </div>
      </div>
    </section>
    <section class="m-section">
      <div class="m-wrap m-grid-2">
        <div>
          <p class="m-eyebrow">Just looking?</p>
          <h2 class="m-heading">Try the browser demo</h2>
        </div>
        <div>
          <p class="m-copy">
            The browser demo uses a device passkey. Data lives in your browser, with limited
            demo-hub backups: 10 MB, expiring after 24 hours of inactivity. Export anything you want
            to keep.
          </p>
          <div class="m-actions">
            <a class="m-button secondary" href="https://xnet.fyi/app/">
              Open the browser demo ↗
            </a>
            <a class="m-text-link" href="/mobile">
              Mobile developer demo →
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .download-option {
    border-top: 1px solid var(--rule);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 22px;
  }
  .download-option h2 {
    font-size: 40px;
    letter-spacing: -0.05em;
  }
  .download-option p {
    color: var(--muted);
  }
  .download-option .download-button {
    margin-top: 16px;
  }
</style>
