---
import Base from '../layouts/Base.astro'
import Nav from '../components/sections/Nav.astro'
import Footer from '../components/sections/Footer.astro'
import Closing from '../components/marketing/Closing.astro'
const stages = [
  {
    state: 'Available now · Alpha',
    title: 'A place for your own work.',
    body: 'The desktop and browser workspace already bring documents, databases, and canvases together. The desktop library collects saved sources. Underneath are local storage, signed changes, sync, and an open protocol.',
    points: [
      'Desktop releases and a browser demo',
      'Documents, databases, canvases, and a desktop library',
      'Published developer packages and self-hostable hub software'
    ],
    href: '/workspace',
    link: 'Explore what you can use'
  },
  {
    state: 'Current focus',
    title: 'Make it a dependable daily habit.',
    body: 'The next measure is ordinary use: can someone write, plan, collect, and organise here day after day? Reliability, recovery, and the small points of friction matter as much as new features.',
    points: [
      'Keep improving startup, recovery, and everyday editing',
      'Make agent work useful and its effects easy to review',
      'Move from technical setup toward an integrated experience'
    ],
    href: '/changelog',
    link: 'Follow what is actually shipping'
  },
  {
    state: 'Next horizon',
    title: 'Make your cloud feel like yours.',
    body: 'Hub and hosting foundations exist. The goal is to make a private, durable, connected workspace straightforward for someone who doesn’t want to operate a server.',
    points: [
      'Simpler onboarding and cross-device setup',
      'Clear recovery and portable identity',
      'Hosted convenience alongside a real self-hosting option'
    ],
    href: '/cloud',
    link: 'Understand the hosting direction'
  },
  {
    state: 'Longer-term vision',
    title: 'Open the commons.',
    body: 'Build a place where people can discover, share, and adapt what others make. Publishing and identity work provide some foundations; the broader discovery and circulation experience remains a direction, not a finished network.',
    points: [
      'Useful tools and knowledge shared with provenance',
      'A commons that grows from real communities',
      'Connections to the wider decentralised web'
    ],
    href: '/blog/the-worlds-greatest-record-store',
    link: 'Read the idea behind the commons'
  }
]
---

<Base
  title="The road ahead — xNet"
  description="What xNet ships today, what we’re working on, and the longer journey toward tools and communities you can own."
>
  <Nav />
  <main id="main-content">
    <header class="m-page-hero">
      <div class="m-wrap">
        <p class="m-eyebrow">The road ahead</p>
        <h1 class="m-title">
          Build something useful.
          <br />
          <em>Let it grow from there.</em>
        </h1>
        <p class="m-lede">
          The vision is broad. The next step is practical: a workspace people want to come back to.
          Here’s how the pieces fit together.
        </p>
        <p class="m-note mt-6">Direction, not delivery dates · Product snapshot: October 2026</p>
      </div>
    </header>
    <section class="m-section">
      <div class="m-wrap">
        {stages.map((stage, i) => (
          <article class="roadmap-stage">
            <div>
              <span class:list={['m-status', { now: i === 0 }]}>{stage.state}</span>
              <p class="stage-number">0{i + 1}</p>
            </div>
            <div>
              <h2 class="m-heading">{stage.title}</h2>
              <p class="m-copy mt-6">{stage.body}</p>
              <ul class="stage-points">
                {stage.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a class="m-text-link mt-6" href={stage.href}>
                {stage.link} →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <Closing
      title="Help shape the next chapter."
      body="Try the alpha, tell us where it gets in your way, or bring something of your own to the code."
    />
  </main>
  <Footer />
</Base>
<style>
  .roadmap-stage {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    padding: 60px 0;
    border-bottom: 1px solid var(--rule);
  }
  .roadmap-stage:first-child {
    padding-top: 0;
  }
  .stage-number {
    font:
      100px/1.4 Georgia,
      serif;
    color: var(--rule);
  }
  .stage-points {
    margin-top: 28px;
    display: grid;
    gap: 10px;
    color: var(--muted);
    font-size: 15px;
  }
  .stage-points li {
    border-top: 1px solid var(--rule);
    padding-top: 12px;
  }
  @media (max-width: 800px) {
    .roadmap-stage {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .stage-number {
      display: none;
    }
  }
</style>
