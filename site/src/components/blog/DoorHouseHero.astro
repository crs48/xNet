---
// Hero band for "The Door Inside the House" (exploration 0444). The decorative
// art lives in DoorHouseArt.astro so the same inline SVG backs both this hero
// and the blog-index preview card.
import DoorHouseArt from './DoorHouseArt.astro'

interface Props {
  title: string
  deck: string
  date: string
  readingMinutes: number
  tags: string[]
}
const { title, deck, date, readingMinutes, tags } = Astro.props
---

<section class="relative overflow-hidden border-b border-border bg-surface/20 dark:bg-[#141416]">
  <DoorHouseArt />
  {/* Scrim: the room glow sits right where the deck lands, so the copy gets its
      own darkness to stand on. Kept here rather than in DoorHouseArt so the
      index card renders the illustration undimmed. */}
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#141416]/85 via-[#141416]/70 to-[#141416]/40"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-6 pb-14 pt-44 lg:pt-52">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-emerald-200/80">
      <time datetime={date}>{date}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes} min read</span>
      {
        tags.map((tag) => (
          <span class="rounded-full border border-emerald-400/30 bg-emerald-500/10 px-2 py-0.5 font-mono lowercase text-emerald-200">
            {tag}
          </span>
        ))
      }
    </div>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-white drop-shadow lg:text-5xl">
      {title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-300">{deck}</p>
  </div>
</section>
