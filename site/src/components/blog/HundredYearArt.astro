---
// Decorative art for "The Hundred-Year Machine" (exploration 0454), single-sourced
// so the same inline SVG backs the post hero and the blog-index preview card
// (no external assets — Self-Audit parity).
//
// The picture is the essay's closing walk, read left to right. The apartment at
// night: a lamp throwing warm light over the machines that survive their makers —
// the treadle sewing machine, the bicycle, the kettle on its ring. Each keeps a
// small live glow. On the right, the newest objects: a flat screen and a smart
// speaker, dark, with a power cord that ends mid-air — plugged into a company
// rather than a wall. The moon through the window has been working longest of all.
interface Props {
  /** Override the wrapper classes; defaults to full-bleed for hero use. */
  class?: string
}
const { class: className = 'pointer-events-none absolute inset-0 h-full w-full' } = Astro.props

// Floorboard seams, [x1, x2] pairs along the floor line.
const BOARDS: Array<[number, number]> = [
  [40, 180],
  [200, 360],
  [380, 560],
  [580, 760],
  [780, 1000]
]

// Sparks of live warmth on the owned machines: [cx, cy, r].
const GLOWS: Array<[number, number, number]> = [
  [214, 118, 3],
  [418, 226, 2.4],
  [560, 246, 2.6]
]
---

<svg
  class={className}
  viewBox="0 0 1040 340"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="hymDusk" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1c1408" />
      <stop offset="55%" stop-color="#131217" />
      <stop offset="100%" stop-color="#0a0c12" />
    </linearGradient>
    <radialGradient id="hymLamp" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.38" />
      <stop offset="100%" stop-color="#f59e0b" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hymCone" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#fbbf24" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="hymSlab" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#2b303c" />
      <stop offset="100%" stop-color="#1b1f28" />
    </linearGradient>
  </defs>

  <rect width="1040" height="340" fill="url(#hymDusk)"></rect>

  <!-- moonlit window, top right: the oldest working fixture in the picture -->
  <g>
    <rect x="854" y="46" width="96" height="118" rx="4" fill="#0e1320"></rect>
    <line x1="902" y1="46" x2="902" y2="164" stroke="#232a38" stroke-width="3"></line>
    <line x1="854" y1="105" x2="950" y2="105" stroke="#232a38" stroke-width="3"></line>
    <circle cx="924" cy="78" r="13" fill="#cbd5e1" opacity="0.85"></circle>
  </g>

  <!-- the lamp, and the warmth it throws over the owned half of the room -->
  <ellipse cx="250" cy="190" rx="290" ry="200" fill="url(#hymLamp)"></ellipse>
  <g>
    <line x1="214" y1="130" x2="214" y2="282" stroke="#553c22" stroke-width="6"></line>
    <path d="M 188 130 L 240 130 L 228 104 L 200 104 Z" fill="#a16207" opacity="0.95"></path>
    <polygon points="192,132 118,282 312,282 236,132" fill="url(#hymCone)"></polygon>
  </g>

  <!-- the treadle sewing machine: table, wheel, foot plate; sewing since 1900 -->
  <g>
    <rect x="360" y="216" width="130" height="8" rx="2" fill="#553c22"></rect>
    <line x1="372" y1="224" x2="372" y2="282" stroke="#3b2c1c" stroke-width="6"></line>
    <line x1="476" y1="224" x2="476" y2="282" stroke="#3b2c1c" stroke-width="6"></line>
    <rect x="388" y="188" width="58" height="28" rx="4" fill="#78350f"></rect>
    <circle cx="466" cy="204" r="14" fill="none" stroke="#a16207" stroke-width="4"></circle>
    <rect x="388" y="262" width="64" height="8" rx="3" fill="#3b2c1c"></rect>
  </g>

  <!-- the bicycle, leaning on nothing but geometry -->
  <g opacity="0.9">
    <circle cx="560" cy="258" r="24" fill="none" stroke="#a16207" stroke-width="3.5"></circle>
    <circle cx="638" cy="258" r="24" fill="none" stroke="#a16207" stroke-width="3.5"></circle>
    <path
      d="M 560 258 L 586 218 L 622 218 L 638 258 M 586 218 L 598 258 L 560 258 M 622 218 L 616 206 M 610 206 L 626 206"
      fill="none"
      stroke="#a16207"
      stroke-width="3"></path>
  </g>
  {GLOWS.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} fill="#fde68a" opacity="0.9" />)}

  <!-- the dark half: screen and speaker, cords ending mid-air -->
  <g>
    <rect x="742" y="196" width="104" height="64" rx="5" fill="url(#hymSlab)"></rect>
    <rect x="748" y="202" width="92" height="52" rx="3" fill="#0b0e14"></rect>
    <rect x="784" y="260" width="20" height="10" fill="#2b303c"></rect>
    <!-- power symbol, unlit -->
    <circle cx="794" cy="228" r="9" fill="none" stroke="#334155" stroke-width="2.4"></circle>
    <line x1="794" y1="219" x2="794" y2="228" stroke="#334155" stroke-width="2.4"></line>
    <!-- the cord that goes to a company, not a wall -->
    <path
      d="M 846 252 C 890 258 906 236 918 214"
      fill="none"
      stroke="#334155"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="1 8"></path>
  </g>
  <g>
    <rect x="884" y="238" width="34" height="48" rx="8" fill="url(#hymSlab)"></rect>
    <circle cx="901" cy="256" r="7" fill="#0b0e14"></circle>
    <circle cx="901" cy="274" r="4" fill="#0b0e14"></circle>
  </g>

  <!-- floor -->
  <rect x="0" y="286" width="1040" height="54" fill="#090b10"></rect>
  <line x1="0" y1="286" x2="1040" y2="286" stroke="#2f2b26" stroke-width="1.5"></line>
  {
    BOARDS.map(([x1, x2]) => (
      <line x1={x1} y1="306" x2={x2} y2="306" stroke="#181a20" stroke-width="1.2" />
    ))
  }
</svg>
