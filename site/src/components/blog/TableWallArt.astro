---
// Decorative art for "The Table and the Wall" (exploration 0443), single-sourced
// so the same inline SVG backs the post hero and the blog-index preview card
// (no external assets — Self-Audit parity).
//
// The picture is the essay's thesis, read left to right. On the left, a warm
// parlour: a wooden table mid-séance, tipped up on two legs and dancing, with
// the pale ghosts of the people who made it fading behind it — the commodity
// forgetting its makers. On the right, a cold concrete wall in cross-section,
// and every fixture on it — the tower lamp, the angled posts, the wire — faces
// left, back at its own side. Between the two halves runs a single signal wire,
// snapped in the middle: the severed channel both halves of the essay are about.
interface Props {
  /** Override the wrapper classes; defaults to full-bleed for hero use. */
  class?: string
}
const { class: className = 'pointer-events-none absolute inset-0 h-full w-full' } = Astro.props

// The makers behind the table: [x, y, opacity] — deliberately faded, mid-vanish.
const MAKERS: Array<[number, number, number]> = [
  [96, 210, 0.35],
  [148, 200, 0.25],
  [206, 214, 0.18]
]

// The people on the inside of the wall: a small grey crowd, all of it to the
// left of the slab, none of it to the right.
const INSIDE: Array<[number, number]> = [
  [676, 252],
  [712, 258],
  [746, 250],
  [706, 274],
  [744, 276]
]

// Motion arcs under the dancing table's airborne legs.
const ARCS = [
  'M 300 236 Q 316 224 332 236',
  'M 292 252 Q 314 236 336 252',
  'M 284 268 Q 312 248 340 268'
]
---

<svg
  class={className}
  viewBox="0 0 1040 340"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="tableWallDusk" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#241708" />
      <stop offset="48%" stop-color="#161210" />
      <stop offset="100%" stop-color="#0c1016" />
    </linearGradient>
    <radialGradient id="parlourGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.38" />
      <stop offset="100%" stop-color="#f59e0b" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="wallFace" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#3a4150" />
      <stop offset="100%" stop-color="#232833" />
    </linearGradient>
    <linearGradient id="lampCone" x1="1" y1="0" x2="0" y2="0">
      <stop offset="0%" stop-color="#93c5fd" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#93c5fd" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="tableTop" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#b45309" />
      <stop offset="100%" stop-color="#78350f" />
    </linearGradient>
  </defs>

  <rect width="1040" height="340" fill="url(#tableWallDusk)"></rect>

  <!-- candlelight over the parlour end -->
  <ellipse cx="250" cy="170" rx="300" ry="200" fill="url(#parlourGlow)" opacity="0.6"></ellipse>

  <!-- the candle the séance is lit by -->
  <g transform="translate(120 250)">
    <rect x="-5" y="0" width="10" height="34" rx="2" fill="#fef3c7" opacity="0.8"></rect>
    <ellipse cx="0" cy="-8" rx="5" ry="9" fill="#fbbf24" opacity="0.9"></ellipse>
    <ellipse cx="0" cy="-10" rx="2" ry="4" fill="#fef9c3"></ellipse>
  </g>

  <!-- the makers, mid-vanish behind their own table -->
  {
    MAKERS.map(([x, y, opacity]) => (
      <g opacity={opacity}>
        <circle cx={x} cy={y} r="13" fill="#fcd34d" />
        <rect x={x - 10} y={y + 14} width="20" height="26" rx="8" fill="#fcd34d" />
      </g>
    ))
  }

  <!-- the table: up on two legs, mid-dance -->
  <g transform="translate(290 200) rotate(-16)">
    <rect x="-88" y="-10" width="176" height="14" rx="4" fill="url(#tableTop)"></rect>
    <rect x="-78" y="4" width="9" height="66" rx="3" fill="#92400e"></rect>
    <rect x="-38" y="4" width="9" height="62" rx="3" fill="#92400e"></rect>
    <rect x="30" y="4" width="9" height="58" rx="3" fill="#a16207"></rect>
    <rect x="69" y="4" width="9" height="54" rx="3" fill="#a16207"></rect>
  </g>
  <!-- grotesque ideas leaving the wooden brain -->
  <circle cx="352" cy="128" r="4" fill="#fbbf24" opacity="0.7"></circle>
  <circle cx="378" cy="104" r="3" fill="#f59e0b" opacity="0.55"></circle>
  <circle cx="398" cy="82" r="2.4" fill="#fcd34d" opacity="0.4"></circle>
  <!-- motion arcs where the airborne legs kicked -->
  {ARCS.map((d) => <path d={d} fill="none" stroke="#fcd34d" stroke-width="1.4" opacity="0.35" />)}

  <!-- the signal wire, snapped mid-frame: two frayed ends and a gap -->
  <path
    d="M 150 296 C 300 306 420 302 486 296"
    fill="none"
    stroke="#fbbf24"
    stroke-width="2"
    opacity="0.55"></path>
  <path d="M 486 296 l 10 -7 M 486 296 l 11 3" stroke="#fbbf24" stroke-width="1.6" opacity="0.55" fill="none"></path>
  <path
    d="M 548 297 C 640 302 760 300 900 290"
    fill="none"
    stroke="#64748b"
    stroke-width="2"
    opacity="0.5"></path>
  <path d="M 548 297 l -10 -7 M 548 297 l -11 4" stroke="#64748b" stroke-width="1.6" opacity="0.5" fill="none"></path>

  <!-- the wall: a cold slab, everything on it aimed at its own side -->
  <g>
    <rect x="852" y="52" width="66" height="240" fill="url(#wallFace)"></rect>
    <rect x="852" y="52" width="66" height="10" fill="#48505f"></rect>
    <!-- tower lamp on top, cone thrown inward (left) -->
    <rect x="872" y="20" width="10" height="32" fill="#2c313c"></rect>
    <circle cx="870" cy="24" r="7" fill="#93c5fd" opacity="0.85"></circle>
    <polygon points="864,24 620,180 620,260 864,34" fill="url(#lampCone)"></polygon>
    <!-- angled posts leaning inward off the wall face -->
    <line x1="852" y1="96" x2="806" y2="80" stroke="#48505f" stroke-width="5"></line>
    <line x1="852" y1="150" x2="806" y2="134" stroke="#48505f" stroke-width="5"></line>
    <line x1="852" y1="204" x2="806" y2="188" stroke="#48505f" stroke-width="5"></line>
    <!-- wire strung along the inward faces of the posts -->
    <path
      d="M 806 80 Q 800 108 806 134 Q 800 160 806 188"
      fill="none"
      stroke="#94a3b8"
      stroke-width="1.4"
      opacity="0.7"></path>
    <circle cx="803" cy="107" r="2" fill="#94a3b8" opacity="0.8"></circle>
    <circle cx="803" cy="161" r="2" fill="#94a3b8" opacity="0.8"></circle>
  </g>

  <!-- the crowd on the inside; the far side of the slab stays empty -->
  {
    INSIDE.map(([x, y]) => (
      <circle cx={x} cy={y} r="11" fill="#64748b" opacity="0.75" />
    ))
  }

  <!-- ground -->
  <rect x="0" y="288" width="1040" height="52" fill="#0b0d12"></rect>
  <line x1="0" y1="288" x2="1040" y2="288" stroke="#33302b" stroke-width="1.5"></line>
</svg>
