---
interface Props {
  as?: 'h1' | 'h2'
  title: string
  subtitle?: string
  align?: 'left' | 'center'
}

const { title, subtitle, align = 'left', as: Heading = 'h2' } = Astro.props
const alignClass = align === 'center' ? 'text-center' : ''
---

<div class={`${alignClass}`}>
  <Heading class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-3xl">
    {title}
  </Heading>
  {subtitle && (
    <p
      class={`mt-3 text-base text-gray-500 dark:text-gray-400 ${align === 'center' ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}
    >
      {subtitle}
    </p>
  )}
</div>
