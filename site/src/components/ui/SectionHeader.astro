---
interface Props {
  as?: 'h1' | 'h2'
  title: string
  subtitle?: string
  align?: 'left' | 'center'
}

const { title, subtitle, align = 'left', as: Heading = 'h2' } = Astro.props
const alignClass = align === 'center' ? 'text-center' : ''
---

<div class={`${alignClass}`}>
  <Heading class="m-heading">
    <span class="bg-gradient-to-br from-gray-900 to-gray-500 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
      {title}
    </span>
  </Heading>
  {subtitle && (
    <p
      class={`mt-3 text-lg text-gray-500 dark:text-gray-400 ${align === 'center' ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}
    >
      {subtitle}
    </p>
  )}
</div>
