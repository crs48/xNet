---
import BrandWordmark from '../BrandWordmark.astro'
const groups = [
  {
    title: 'Workspace',
    links: [
      ['The workspace', '/workspace'],
      ['Download', '/download'],
      ['Browser demo', 'https://xnet.fyi/app/'],
      ['What’s new', '/changelog'],
      ['Roadmap', '/roadmap'],
      ['Mobile demo', '/mobile']
    ]
  },
  {
    title: 'Project',
    links: [
      ['Vision', '/why'],
      ['Blog', '/blog'],
      ['Our commitments', '/commitments'],
      ['Open metrics', '/open'],
      ['Cloud & hosting', '/cloud'],
      ['Hosting prices', '/cloud/pricing']
    ]
  },
  {
    title: 'Developers',
    links: [
      ['Developer overview', '/build-with'],
      ['Documentation', '/docs/introduction/'],
      ['React SDK', '/react'],
      ['Agent tools', '/agents'],
      ['Plugins', '/plugins'],
      ['Live demos', '/demos'],
      ['DevTools', '/devtool'],
      ['Compare', '/compare']
    ]
  }
]
---

<footer class="site-footer">
  <div class="m-wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="xNet home">
          <BrandWordmark />
        </a>
        <p>
          A workspace of your own.
          <br />
          Local-first. Open source.
        </p>
        <a class="m-text-link" href="https://github.com/crs48/xNet">
          Source on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      {groups.map((group) => (
        <div>
          <h2>{group.title}</h2>
          <ul>
            {group.links.map(([label, href]) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} xNet · Made in the open.</p>
      <div>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/acceptable-use">Acceptable use</a>
        <a href="/status">Status</a>
        <a href="https://github.com/crs48/xNet/discussions">Say hello ↗</a>
        <a href="/blog/rss.xml">RSS ↗</a>
      </div>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    padding: 40px 0 24px;
    border-top: 1px solid var(--rule);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }
  .footer-brand > a:first-child {
    display: inline-flex;
  }
  .footer-brand :global(.brand-wordmark) {
    height: 32px;
  }
  .footer-brand p {
    margin: 22px 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }
  h2 {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  li {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    border-top: 1px solid var(--rule);
    margin-top: 36px;
    padding-top: 24px;
    font-size: 11px;
    color: var(--muted);
  }
  .footer-bottom > div {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 380px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
