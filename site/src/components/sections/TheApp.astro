---
import SectionHeader from '../ui/SectionHeader.astro'

const tools = [
  {
    title: 'Documents',
    description: 'Notes, plans, and drafts with rich text, blocks, and collaborative editing.',
    icon: 'doc',
    color: 'indigo'
  },
  {
    title: 'Databases',
    description:
      'Structure projects and collections with typed fields, relations, and multiple views.',
    icon: 'db',
    color: 'emerald'
  },
  {
    title: 'Canvas',
    description: 'Arrange ideas, connect pieces, and work visually on an open canvas.',
    icon: 'canvas',
    color: 'amber'
  },
  {
    title: 'Personal library',
    description:
      'Save links and import sources alongside your notes. Available in the desktop app.',
    icon: 'doc',
    color: 'violet'
  },
  {
    title: 'Offline editing',
    description: 'Work with a local copy. Sync changes when your devices reconnect.',
    icon: 'task',
    color: 'pink'
  },
  {
    title: 'Workspace export',
    description: 'Keep your own backups in an open .xnetpack bundle while the alpha evolves.',
    icon: 'db',
    color: 'indigo'
  }
]

const colorMap: Record<string, { border: string; bg: string; text: string; iconBg: string }> = {
  indigo: {
    border: 'border-indigo-500/20',
    bg: 'bg-indigo-500/[0.03]',
    text: 'text-indigo-600 dark:text-indigo-400',
    iconBg: 'bg-indigo-500/10'
  },
  emerald: {
    border: 'border-emerald-500/20',
    bg: 'bg-emerald-500/[0.03]',
    text: 'text-emerald-700 dark:text-emerald-400',
    iconBg: 'bg-emerald-500/10'
  },
  amber: {
    border: 'border-amber-500/20',
    bg: 'bg-amber-500/[0.03]',
    text: 'text-amber-700 dark:text-amber-400',
    iconBg: 'bg-amber-500/10'
  },
  pink: {
    border: 'border-pink-500/20',
    bg: 'bg-pink-500/[0.03]',
    text: 'text-pink-600 dark:text-pink-400',
    iconBg: 'bg-pink-500/10'
  },
  violet: {
    border: 'border-violet-500/20',
    bg: 'bg-violet-500/[0.03]',
    text: 'text-violet-600 dark:text-violet-400',
    iconBg: 'bg-violet-500/10'
  }
}
---

<section id="app" class="border-y border-border/50 bg-surface/10 dark:bg-surface/20 py-12 lg:py-14">
  <span id="ai" class="sr-only" aria-hidden="true"></span>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeader
      title="What you can use today"
      subtitle="Start with notes or a project. These are the core tools in the current alpha."
      align="center"
    />

    <!-- Tools grid: six marquee surfaces -->
    <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => {
        const c = colorMap[tool.color]
        return (
          <div
            class={`animate-on-scroll rounded-xl border ${c.border} ${c.bg} p-5 transition-all duration-300 hover:border-opacity-60`}
          >
            <div class="flex items-center gap-3 mb-3">
              <div
                class={`flex h-8 w-8 items-center justify-center rounded-lg ${c.iconBg} ${c.text}`}
              >
                {tool.icon === 'doc' && (
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                )}
                {tool.icon === 'db' && (
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"
                    />
                  </svg>
                )}
                {tool.icon === 'canvas' && (
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5z"
                    />
                  </svg>
                )}
                {tool.icon === 'task' && (
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                    />
                  </svg>
                )}
                {tool.icon === 'chat' && (
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                    />
                  </svg>
                )}
                {tool.icon === 'spark' && (
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.6"
                      d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"
                    />
                  </svg>
                )}
              </div>
              <h3 class={`font-semibold ${c.text}`}>{tool.title}</h3>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
              {tool.description}
            </p>
          </div>
        )
      })}
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm text-gray-500 dark:text-gray-400">
      <p>
        <a href="/download" class="font-medium text-gray-800 hover:underline dark:text-gray-200">
          Desktop alpha
        </a>{' '}
        ·{' '}
        <a href="https://xnet.fyi/app/" class="hover:underline">
          Browser demo
        </a>{' '}
        ·{' '}
        <a href="/mobile" class="hover:underline">
          Mobile experiment
        </a>
      </p>
      <a href="/workspace" class="font-medium text-indigo-600 hover:underline dark:text-indigo-400">
        Features & common questions →
      </a>
    </div>
  </div>
</section>
