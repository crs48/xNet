---
import ThemeToggle from '../ui/ThemeToggle.astro'

// The header stays deliberately short. Links are grouped: in-page sections first
// (in the order they appear as you scroll the home page), then standalone
// destination pages. Everything else — Cloud, Plugins, React, Commitments,
// Changelog, the SDK docs — lives in the footer.
const homeLinks = [
  { href: '/#app', label: 'App' },
  { href: '/#developers', label: 'Developers' },
  { href: '/#open', label: 'Open' },
]
const pageLinks = [
  { href: '/agents', label: 'Agents' },
  { href: '/why', label: 'Why' },
  { href: '/build-with', label: 'Build' },
  { href: '/demos/', label: 'Demos' },
  { href: '/blog', label: 'Blog' },
]
---

<header class="sticky top-0 z-50 border-b border-border/50 bg-white/80 dark:bg-[#0a0a0f]/80 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="brand font-mono text-xl font-bold tracking-tight text-gray-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
      <!-- Below md the nav row is already over-full (pre-existing), so the
           mark stays out of that band rather than adding to the overflow. -->
      <span class="brand-mark hidden md:block" aria-hidden="true"></span>
      xNet
    </a>
    <!-- Tighter link spacing below lg: the brand mark costs ~32px and the row
         has no slack left at tablet widths. Desktop spacing is unchanged. -->
    <div class="flex items-center gap-4 lg:gap-5 text-sm">
      {homeLinks.map(link => (
        <a href={link.href} class="hidden sm:inline text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
          {link.label}
        </a>
      ))}
      <span class="hidden sm:inline h-4 w-px bg-border" aria-hidden="true"></span>
      {pageLinks.map(link => (
        <a href={link.href} class="hidden sm:inline text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
          {link.label}
        </a>
      ))}
      <a href="/docs/introduction/" class="flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:border-indigo-500/50 hover:bg-surface transition-all">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
        </svg>
        Docs
      </a>
      <a href="/agents" class="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500 transition-all">
        Connect your agent
      </a>
      <ThemeToggle />
      <a
        href="https://github.com/crs48/xNet"
        aria-label="xNet on GitHub"
        class="hidden sm:flex items-center rounded-lg border border-border p-1.5 text-gray-600 dark:text-gray-300 hover:border-indigo-500/50 hover:bg-surface transition-all"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* The mark is debossed rather than drawn: two offset copies of the same
     alpha mask, a dark incision over a light lower edge, so it reads as
     pressed into the header rather than sitting on it. Deliberately faint —
     it is texture beside the wordmark, not a second logo competing with it. */
  .brand-mark {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }

  .brand-mark::before,
  .brand-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    -webkit-mask: url('/mark.png') center / contain no-repeat;
    mask: url('/mark.png') center / contain no-repeat;
  }

  /* Lower edge catching the light, offset down-right. */
  .brand-mark::before {
    background: rgba(255, 255, 255, 0.9);
    transform: translate(0.5px, 0.5px);
  }

  /* The incision itself. */
  .brand-mark::after {
    background: rgba(15, 23, 42, 0.62);
  }

  /* On the near-black header a dark incision has nowhere to go, so the groove
     is read the other way round: the lit lower edge carries the shape and the
     shadow sits above it. Etched rather than pressed, same intent. */
  :global(.dark) .brand-mark::before {
    background: rgba(0, 0, 0, 0.9);
    transform: translate(-0.5px, -0.5px);
  }

  :global(.dark) .brand-mark::after {
    background: rgba(255, 255, 255, 0.50);
  }

  @media (prefers-reduced-transparency: reduce) {
    .brand-mark::before {
      display: none;
    }
  }
</style>
