---
import BrandWordmark from '../BrandWordmark.astro'
import ThemeToggle from '../ui/ThemeToggle.astro'
const links = [
  { href: '/#app', label: 'App' },
  { href: '/#developers', label: 'Developers' },
  { href: '/why', label: 'Vision' },
  { href: '/blog', label: 'Blog' },
  { href: '/agents', label: 'Agents' },
  { href: '/docs/introduction/', label: 'Docs' }
]
const active = (href: string) => Astro.url.pathname.replace(/\/$/, '') === href
---

<a href="#main-content" class="skip-link">
  Skip to content
</a>
<header class="site-nav">
  <nav class="m-wrap nav-inner" aria-label="Main navigation">
    <a href="/" aria-label="xNet home" class="nav-brand">
      <BrandWordmark />
    </a>
    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </div>
    <div class="nav-tools">
      <ThemeToggle />
      <a class="m-button nav-try" href="/download">
        Try xNet <span aria-hidden="true">↗</span>
      </a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          Menu <span aria-hidden="true">+</span>
        </summary>
        <div>
          {links.map((link) => (
            <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <a href="/roadmap">Roadmap</a>
          <a href="/build-with">Build with xNet</a>
          <a href="/download">Get xNet</a>
        </div>
      </details>
    </div>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu')
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.open = false
    })
  })
</script>
<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .nav-inner {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .nav-brand {
    display: inline-flex;
    flex-shrink: 0;
  }
  .nav-brand :global(.brand-wordmark) {
    height: 28px;
  }
  .nav-links {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-size: 13px;
  }
  .nav-links a {
    padding-block: 10px;
    color: var(--muted);
  }
  .nav-links a:hover,
  .nav-links [aria-current] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .nav-tools {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .nav-try {
    padding: 10px 15px;
    font-size: 12px;
  }
  .mobile-menu {
    display: none;
  }
  @media (max-width: 960px) {
    .nav-inner {
      height: 64px;
      gap: 14px;
    }
    .nav-links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .mobile-menu summary {
      cursor: pointer;
      list-style: none;
      font-size: 13px;
      display: flex;
      gap: 12px;
      padding-block: 12px;
    }
    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }
    .mobile-menu > div {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      padding: 24px;
      border-bottom: 1px solid var(--rule);
      background: var(--paper);
      display: grid;
      gap: 18px;
    }
    .nav-tools {
      gap: 14px;
    }
  }
  @media (max-width: 420px) {
    .nav-try {
      display: none;
    }
  }
</style>
