---
const paths = [
  {
    title: 'Use the workspace',
    body: 'Try it in a browser or download the desktop alpha.',
    href: '/download',
    link: 'Download xNet',
    color: 'border-emerald-500/25',
    label: 'text-emerald-700 dark:text-emerald-400'
  },
  {
    title: 'Build a tool',
    body: 'Start with a schema and the SDK. Read the source as you go.',
    href: '/docs/quickstart/',
    link: 'Developer quickstart',
    color: 'border-indigo-500/25',
    label: 'text-indigo-600 dark:text-indigo-400'
  },
  {
    title: 'Follow the project',
    body: 'Read what’s shipped and join the discussion.',
    href: '/changelog',
    link: 'Changelog',
    color: 'border-violet-500/25',
    label: 'text-violet-600 dark:text-violet-400'
  }
]
---

<section id="get-started" class="bg-surface/30 py-10">
  <div class="mx-auto grid max-w-6xl gap-4 px-6 sm:grid-cols-3">
    {paths.map((path) => (
      <article class={`rounded-xl border bg-white p-5 dark:bg-gray-900 ${path.color}`}>
        <h2 class="text-base font-semibold">{path.title}</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{path.body}</p>
        <a
          class={`mt-4 inline-block text-sm font-medium hover:underline ${path.label}`}
          href={path.href}
        >
          {path.link} →
        </a>
      </article>
    ))}
  </div>
</section>
