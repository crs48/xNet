---
import Badge from '../ui/Badge.astro'
---

<section class="border-b border-border">
  <span id="what-is-xnet" class="sr-only" aria-hidden="true"></span>
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-6 py-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-10 lg:py-16">
    <div>
      <Badge>
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>Open alpha · Desktop & web
      </Badge>
      <h1 class="mt-5 text-4xl font-bold leading-[1.08] tracking-tight text-gray-950 dark:text-white sm:text-5xl lg:text-6xl">
        A workspace
        <br />
        you own.
      </h1>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        Documents, databases, canvases, and a personal library. Your work lives on your device, with
        an open data layer you can build on.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/download" class="m-button">
          Download xNet <span aria-hidden="true">↓</span>
        </a>
        <a href="https://xnet.fyi/app/" class="m-button secondary">
          Try the browser demo <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul
        class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs text-gray-500 dark:text-gray-400"
        aria-label="Workspace principles"
      >
        <li>
          <span class="mr-1 text-emerald-600 dark:text-emerald-400">✓</span>Works offline
        </li>
        <li>
          <span class="mr-1 text-emerald-600 dark:text-emerald-400">✓</span>Open source
        </li>
        <li>
          <span class="mr-1 text-emerald-600 dark:text-emerald-400">✓</span>Export your data
        </li>
      </ul>
    </div>
    <figure class="min-w-0">
      <div class="overflow-hidden rounded-xl border border-border bg-surface shadow-lg shadow-gray-950/5">
        <div class="flex items-center gap-2 border-b border-border px-3 py-2">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-red-400"></span>
            <span class="h-2 w-2 rounded-full bg-amber-400"></span>
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          </div>
          <span class="ml-2 text-xs text-gray-500">xNet workspace</span>
        </div>
        <img
          src="/images/workbench-light.png"
          width="1600"
          height="1000"
          class="block w-full dark:hidden"
          alt="The xNet workspace with an example project document open beside the explorer."
          loading="eager"
          fetchpriority="high"
        />
        <img
          src="/images/workbench-dark.png"
          width="1600"
          height="1000"
          class="hidden w-full dark:block"
          alt="The xNet workspace in dark mode with an example project document."
          loading="eager"
        />
      </div>
      <figcaption class="mt-3 flex justify-between gap-3 text-xs text-gray-500">
        <span>Desktop alpha · Example content</span>
        <a href="/workspace" class="text-indigo-600 hover:underline dark:text-indigo-400">
          Explore the app →
        </a>
      </figcaption>
    </figure>
  </div>
</section>
