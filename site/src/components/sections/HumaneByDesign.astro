---
import SectionHeader from '../ui/SectionHeader.astro'
import BlogArt from '../blog/BlogArt.astro'
const ideas = [
  {
    title: 'Keep your work when tools change',
    body: 'Local copies, open formats, and exports give you a way to leave. The goal is software you can still use after its maker moves on.',
    slug: 'the-hundred-year-machine',
    essay: 'The Hundred-Year Machine'
  },
  {
    title: 'Let different tools share the ground',
    body: 'Data should be useful beyond the app that created it. Open schemas let people make new tools around records they already own.',
    slug: 'data-should-work-like-soil',
    essay: 'Data Should Work Like Soil'
  },
  {
    title: 'Let communities outlast their servers',
    body: 'The longer vision is an open network of shared knowledge and tools, where changing hosts doesn’t mean losing a community’s history.',
    slug: 'the-worlds-greatest-record-store',
    essay: 'The World’s Greatest Record Store'
  }
]
---

<section id="open" class="border-b border-border bg-surface/30 py-12 lg:py-14">
  <span id="vision" class="sr-only" aria-hidden="true"></span>
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeader
        title="Your data should outlast your apps"
        subtitle="The workspace is a starting point for a more open web. These ideas from the blog guide what we build."
      />
      <a
        href="/why"
        class="shrink-0 text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        The full vision →
      </a>
    </div>
    <div class="mt-7 grid gap-4 md:grid-cols-3">
      {ideas.map((idea) => (
        <article class="overflow-hidden rounded-xl border border-border bg-white dark:bg-gray-900">
          <a href={`/blog/${idea.slug}`}>
            <BlogArt
              slug={idea.slug}
              class="h-32 w-full object-cover"
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </a>
          <div class="p-5">
            <h3 class="text-lg font-semibold leading-snug">{idea.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{idea.body}</p>
            <a
              href={`/blog/${idea.slug}`}
              class="mt-4 inline-block text-xs font-medium text-indigo-600 hover:underline dark:text-indigo-400"
            >
              {idea.essay} →
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-5 text-sm text-gray-500 dark:text-gray-400">
      Privacy, consent, and the right to leave are in our{' '}
      <a href="/commitments" class="text-indigo-600 hover:underline dark:text-indigo-400">
        commitments
      </a>
      . Read the arguments and tradeoffs across{' '}
      <a href="/blog" class="text-indigo-600 hover:underline dark:text-indigo-400">
        all the essays →
      </a>
    </p>
  </div>
</section>
