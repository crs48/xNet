---
import SectionHeader from '../ui/SectionHeader.astro'
const stages = [
  {
    label: 'Available · Alpha',
    color: 'border-emerald-500/25 bg-emerald-500/[0.04]',
    text: 'text-emerald-700 dark:text-emerald-400',
    title: 'The workspace & its foundations',
    points: [
      'Documents, databases, and canvases',
      'Desktop library and workspace export',
      'Open SDKs, sync, and self-hostable hubs'
    ]
  },
  {
    label: 'In progress',
    color: 'border-amber-500/25 bg-amber-500/[0.04]',
    text: 'text-amber-700 dark:text-amber-400',
    title: 'Reliable daily use',
    points: [
      'Startup, recovery, and editing improvements',
      'Easier sync and hosting setup',
      'Integrated AI with permission and review'
    ]
  },
  {
    label: 'Longer-term vision',
    color: 'border-violet-500/25 bg-violet-500/[0.04]',
    text: 'text-violet-700 dark:text-violet-400',
    title: 'An open commons',
    points: [
      'Portable identity and shared spaces',
      'Discover and adapt community-made tools',
      'Knowledge that travels between hosts'
    ]
  }
]
---

<section id="roadmap" class="border-b border-border py-12 lg:py-14">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeader title="Current release and roadmap" />
      <a
        href="/roadmap"
        class="text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Full roadmap →
      </a>
    </div>
    <div class="mt-7 grid gap-4 md:grid-cols-3">
      {stages.map((stage) => (
        <article class={`rounded-xl border p-5 ${stage.color}`}>
          <p class={`text-xs font-semibold ${stage.text}`}>{stage.label}</p>
          <h3 class="mt-2 text-lg font-semibold">{stage.title}</h3>
          <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-400">
            {stage.points.map((point) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class={stage.text}>
                  ·
                </span>
                {point}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <aside
      id="agents"
      class="mt-5 flex flex-col justify-between gap-3 rounded-lg border border-indigo-500/20 bg-indigo-500/[0.04] px-5 py-4 sm:flex-row sm:items-center"
    >
      <p class="text-sm text-gray-600 dark:text-gray-400">
        <strong class="text-gray-900 dark:text-gray-100">AI today:</strong> CLI, file checkout, and
        MCP tools are available for developers. A simple built-in assistant is still being built.
      </p>
      <a
        href="/agents"
        class="shrink-0 text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Agent tools →
      </a>
    </aside>
  </div>
</section>
