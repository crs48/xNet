---
import BrandWordmark from '../BrandWordmark.astro'

/**
 * Custom Starlight SiteTitle — "xNet" links to landing page, "Docs" links to docs root.
 */
---

<div class="site-title sl-flex">
  <a href="/" class="site-title-brand" aria-label="xNet"><BrandWordmark /></a>
  <span class="site-title-separator">/</span>
  <a href="/docs/introduction/" class="site-title-docs">Docs</a>
</div>

<style>
  .site-title {
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: var(--sl-text-lg);
    text-decoration: none;
    color: var(--sl-color-white);
    white-space: nowrap;
  }

  .site-title-brand {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }

  .site-title-brand:hover {
    color: var(--sl-color-accent);
  }

  .site-title-separator {
    color: var(--sl-color-gray-4);
    font-weight: 400;
  }

  .site-title-docs {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 500;
  }

  .site-title-docs:hover {
    color: var(--sl-color-accent);
  }
</style>
